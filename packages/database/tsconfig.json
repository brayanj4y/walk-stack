{
    "compilerOptions": {
        "target": "ESNext",
        "lib": [
            "ESNext",
            "DOM"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true
    },
    "include": [
        "convex",
        "src"
    ],
    "exclude": [
        "node_modules"
    ]
}